---
import { messages } from "../i18n";
const t = messages.es;

const segments = [
  {
    tag: "seg1.tag", age: "seg1.age", title: "seg1.title", desc: "seg1.desc",
    points: ["seg1.p1", "seg1.p2", "seg1.p3"],
    icon: `<path d="M3 11.5 12 4l9 7.5M5 10v10h14V10" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    tag: "seg2.tag", age: "seg2.age", title: "seg2.title", desc: "seg2.desc",
    points: ["seg2.p1", "seg2.p2", "seg2.p3"],
    icon: `<path d="M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];
---

<section id="segmentos" class="relative bg-slate-50 py-20 lg:py-28 dark:bg-navy-900/40">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" data-i18n="seg.kicker">{t["seg.kicker"]}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white" data-i18n="seg.title">{t["seg.title"]}</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300" data-i18n="seg.sub">{t["seg.sub"]}</p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {segments.map((s, i) => (
        <div class="reveal rounded-card border border-slate-200 bg-white p-8 shadow-sm lg:p-10 dark:border-navy-800 dark:bg-navy-900 dark:shadow-none" style={`transition-delay: ${i * 100}ms`}>
          <div class="flex items-center gap-4">
            <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={s.icon}></svg>
            </span>
            <div>
              <p class="text-base font-bold text-slate-900 dark:text-white" data-i18n={s.tag}>{t[s.tag]}</p>
              <p class="text-xs font-medium text-slate-400" data-i18n={s.age}>{t[s.age]}</p>
            </div>
          </div>

          <h3 class="mt-6 font-display text-xl font-bold text-slate-900 dark:text-white" data-i18n={s.title}>{t[s.title]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400" data-i18n={s.desc}>{t[s.desc]}</p>

          <ul class="mt-6 space-y-3">
            {s.points.map((p) => (
              <li class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-300">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" class="shrink-0"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span data-i18n={p}>{t[p]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
