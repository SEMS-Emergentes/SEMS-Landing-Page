---
import { messages } from "../i18n";
const t = messages.es;

const faqs = [
  { q: "faq.q1", a: "faq.a1" },
  { q: "faq.q2", a: "faq.a2" },
  { q: "faq.q3", a: "faq.a3" },
  { q: "faq.q4", a: "faq.a4" },
  { q: "faq.q5", a: "faq.a5" },
  { q: "faq.q6", a: "faq.a6" },
];
---

<section id="faq" class="relative bg-slate-50 py-20 lg:py-28 dark:bg-navy-900/40">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <div class="reveal text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" data-i18n="faq.kicker">{t["faq.kicker"]}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white" data-i18n="faq.title">{t["faq.title"]}</h2>
    </div>

    <div class="mt-12 space-y-3">
      {faqs.map((f) => (
        <details class="reveal group rounded-xl border border-slate-200 bg-white transition-colors open:border-blue-300 dark:border-navy-800 dark:bg-navy-900 dark:open:border-blue-500/40">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 text-base font-semibold text-slate-900 marker:content-none dark:text-white">
            <span data-i18n={f.q}>{t[f.q]}</span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-blue-600 transition-transform group-open:rotate-45 dark:bg-navy-800 dark:text-blue-400">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
            </span>
          </summary>
          <p class="px-6 pb-5 text-sm leading-relaxed text-slate-600 dark:text-slate-400" data-i18n={f.a}>{t[f.a]}</p>
        </details>
      ))}
    </div>
  </div>
</section>
