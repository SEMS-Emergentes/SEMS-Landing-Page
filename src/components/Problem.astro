---
import { messages } from "../i18n";
const t = messages.es;

const pains = [
  {
    t: "problem.p1t", d: "problem.p1d",
    icon: `<path d="M12 8v4l3 2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9"/>`,
  },
  {
    t: "problem.p2t", d: "problem.p2d",
    icon: `<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3" stroke-linecap="round"/>`,
  },
  {
    t: "problem.p3t", d: "problem.p3d",
    icon: `<path d="M3 3v18h18M7 14l4-4 3 3 5-6" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];
---

<section class="relative py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" data-i18n="problem.kicker">{t["problem.kicker"]}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white" data-i18n="problem.title">{t["problem.title"]}</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300" data-i18n="problem.sub">{t["problem.sub"]}</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {pains.map((p, i) => (
        <div class="reveal rounded-card border border-slate-200 bg-white p-7 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:border-navy-800 dark:bg-navy-900 dark:shadow-none dark:hover:border-navy-700" style={`transition-delay: ${i * 90}ms`}>
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-rose-50 text-rose-500 dark:bg-rose-500/10 dark:text-rose-300">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={p.icon}></svg>
          </span>
          <h3 class="mt-5 text-lg font-bold text-slate-900 dark:text-white" data-i18n={p.t}>{t[p.t]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400" data-i18n={p.d}>{t[p.d]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
