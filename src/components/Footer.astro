---
import { messages } from "../i18n";
const t = messages.es;

const cols = [
  {
    title: "footer.colProduct",
    links: [
      { key: "nav.how", href: "#como-funciona" },
      { key: "nav.features", href: "#caracteristicas" },
      { key: "nav.plans", href: "#planes" },
      { key: "nav.faq", href: "#faq" },
    ],
  },
  {
    title: "footer.colCompany",
    links: [
      { key: "footer.company1", href: "#" },
      { key: "footer.company2", href: "#" },
      { key: "footer.company3", href: "#" },
      { key: "footer.company4", href: "#" },
    ],
  },
  {
    title: "footer.colLegal",
    links: [
      { key: "footer.legal1", href: "#" },
      { key: "footer.legal2", href: "#" },
      { key: "footer.legal3", href: "#" },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white dark:border-navy-800 dark:bg-navy-950">
  <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="#inicio" class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600">
            <svg width="18" height="18" viewBox="0 0 32 32" fill="none"><path d="M17.5 5 9 17.5h5.2L13 27l9.5-13h-5.4z" fill="#fff"/></svg>
          </span>
          <span class="font-display text-xl font-extrabold text-slate-900 dark:text-white">SEMS</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-500 dark:text-slate-400" data-i18n="footer.tagline">{t["footer.tagline"]}</p>
      </div>

      {cols.map((c) => (
        <div>
          <h4 class="text-sm font-semibold text-slate-900 dark:text-white" data-i18n={c.title}>{t[c.title]}</h4>
          <ul class="mt-4 space-y-2.5">
            {c.links.map((l) => (
              <li>
                <a href={l.href} data-i18n={l.key} class="text-sm text-slate-500 transition-colors hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400">{t[l.key]}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 sm:flex-row dark:border-navy-800">
      <p class="text-xs text-slate-400">© {year} Energix · SEMS · <span data-i18n="footer.rights">{t["footer.rights"]}</span></p>
      <p class="text-xs text-slate-400" data-i18n="footer.contact">{t["footer.contact"]}</p>
    </div>
  </div>
</footer>
