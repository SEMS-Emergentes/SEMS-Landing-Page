---
import { messages } from "../i18n";
import DashboardMock from "./DashboardMock.astro";
const t = messages.es;
---

<section id="inicio" class="relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28">
  <div class="bg-grid absolute inset-0 [mask-image:radial-gradient(ellipse_at_top,black,transparent_75%)]"></div>
  <div class="absolute -top-24 right-0 h-72 w-72 rounded-full bg-blue-400/15 blur-3xl dark:bg-blue-500/10"></div>
  <div class="absolute top-1/3 -left-24 h-64 w-64 rounded-full bg-sky-300/20 blur-3xl dark:bg-blue-700/10"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 lg:grid-cols-2 lg:px-8">
    <!-- Texto -->
    <div class="reveal">
      <span class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-blue-700 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-300">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-500 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-600"></span>
        </span>
        <span data-i18n="hero.badge">{t["hero.badge"]}</span>
      </span>

      <h1 class="mt-6 font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-[3.5rem] dark:text-white">
        <span data-i18n="hero.title.a">{t["hero.title.a"]}</span>
        <span class="text-blue-600 dark:text-blue-400" data-i18n="hero.title.b">{t["hero.title.b"]}</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300" data-i18n="hero.sub">
        {t["hero.sub"]}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#planes"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-blue-600/25 transition-all hover:bg-blue-700 hover:shadow-blue-600/40"
        >
          <span data-i18n="hero.cta1">{t["hero.cta1"]}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a
          href="#como-funciona"
          data-i18n="hero.cta2"
          class="inline-flex items-center justify-center rounded-full border border-slate-300 px-7 py-3.5 text-base font-semibold text-slate-700 transition-colors hover:border-blue-400 hover:text-blue-600 dark:border-navy-700 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400"
        >
          {t["hero.cta2"]}
        </a>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm text-slate-500 dark:text-slate-400">
        {["hero.p1", "hero.p2", "hero.p3"].map((k) => (
          <div class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-i18n={k}>{t[k]}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Mockup -->
    <div class="reveal relative lg:pl-6" style="transition-delay: 120ms">
      <DashboardMock />
    </div>
  </div>
</section>
