---
import { messages } from "../i18n";
const t = messages.es;

const features = [
  { t: "feat.f1t", d: "feat.f1d", icon: `<path d="M3 12h4l3 8 4-16 3 8h4" stroke-linecap="round" stroke-linejoin="round"/>` },
  { t: "feat.f2t", d: "feat.f2d", icon: `<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" stroke-linecap="round" stroke-linejoin="round"/>` },
  { t: "feat.f3t", d: "feat.f3d", icon: `<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V18h6v-1.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2Z" stroke-linecap="round" stroke-linejoin="round"/>` },
  { t: "feat.f4t", d: "feat.f4d", icon: `<path d="M4 20V10M12 20V4M20 20v-6" stroke-linecap="round" stroke-linejoin="round"/>` },
  { t: "feat.f5t", d: "feat.f5d", icon: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4M16 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01" stroke-linecap="round" stroke-linejoin="round"/>` },
  { t: "feat.f6t", d: "feat.f6d", icon: `<path d="M3 3v18h18M18 17V9M13 17V5M8 17v-3" stroke-linecap="round" stroke-linejoin="round"/>` },
];
---

<section id="caracteristicas" class="relative py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" data-i18n="feat.kicker">{t["feat.kicker"]}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white" data-i18n="feat.title">{t["feat.title"]}</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300" data-i18n="feat.sub">{t["feat.sub"]}</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <div
          class="reveal group flex flex-col rounded-card border border-slate-200 bg-white p-7 shadow-sm transition-all hover:-translate-y-1 hover:border-blue-200 hover:shadow-md dark:border-navy-800 dark:bg-navy-900 dark:shadow-none dark:hover:border-blue-500/40"
          style={`transition-delay: ${(i % 3) * 80}ms`}
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition-colors group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-500/10 dark:text-blue-400">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={f.icon}></svg>
          </span>
          <h3 class="mt-5 text-lg font-bold text-slate-900 dark:text-white" data-i18n={f.t}>{t[f.t]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400" data-i18n={f.d}>{t[f.d]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
