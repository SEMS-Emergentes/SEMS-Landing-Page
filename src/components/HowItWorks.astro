---
import { messages } from "../i18n";
const t = messages.es;

const steps = [
  { n: "01", t: "how.s1t", d: "how.s1d", icon: `<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9z"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2" stroke-linecap="round"/>` },
  { n: "02", t: "how.s2t", d: "how.s2d", icon: `<path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4Z"/><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>` },
  { n: "03", t: "how.s3t", d: "how.s3d", icon: `<path d="M3 12h4l3 8 4-16 3 8h4" stroke-linecap="round" stroke-linejoin="round"/>` },
  { n: "04", t: "how.s4t", d: "how.s4d", icon: `<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V18h6v-1.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2Z" stroke-linecap="round" stroke-linejoin="round"/>` },
];
---

<section id="como-funciona" class="relative bg-slate-50 py-20 lg:py-28 dark:bg-navy-900/40">
  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" data-i18n="how.kicker">{t["how.kicker"]}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white" data-i18n="how.title">{t["how.title"]}</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300" data-i18n="how.sub">{t["how.sub"]}</p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <div class="reveal relative" style={`transition-delay: ${i * 80}ms`}>
          <div class="h-full rounded-card border border-slate-200 bg-white p-7 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:border-navy-800 dark:bg-navy-900 dark:shadow-none dark:hover:border-navy-700">
            <div class="flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={s.icon}></svg>
              </span>
              <span class="font-display text-3xl font-extrabold text-slate-100 dark:text-navy-800">{s.n}</span>
            </div>
            <h3 class="mt-5 text-lg font-bold text-slate-900 dark:text-white" data-i18n={s.t}>{t[s.t]}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400" data-i18n={s.d}>{t[s.d]}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-blue-300 lg:block dark:text-navy-700">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
