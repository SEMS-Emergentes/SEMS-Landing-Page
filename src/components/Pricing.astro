---
import { messages } from "../i18n";
const t = messages.es;

const plans = [
  { id: "plan1", featured: false, features: ["plan1.f1", "plan1.f2", "plan1.f3", "plan1.f4"] },
  { id: "plan2", featured: true, features: ["plan2.f1", "plan2.f2", "plan2.f3", "plan2.f4", "plan2.f5", "plan2.f6"] },
  { id: "plan3", featured: false, features: ["plan3.f1", "plan3.f2", "plan3.f3", "plan3.f4", "plan3.f5"] },
];
---

<section id="planes" class="relative py-20 lg:py-28">
  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400" data-i18n="price.kicker">{t["price.kicker"]}</span>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white" data-i18n="price.title">{t["price.title"]}</h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        <span data-i18n="price.sub.a">{t["price.sub.a"]}</span>
        <span class="font-semibold text-blue-600 dark:text-blue-400" data-i18n="price.sub.b">{t["price.sub.b"]}</span>
        <span data-i18n="price.sub.c">{t["price.sub.c"]}</span>
      </p>
    </div>

    <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3">
      {plans.map((plan, i) => (
        <div
          class={`reveal relative flex flex-col rounded-card border p-8 transition-all ${
            plan.featured
              ? "border-blue-600 bg-white shadow-xl shadow-blue-600/10 lg:-mt-4 lg:mb-4 dark:bg-navy-900 dark:shadow-blue-600/20"
              : "border-slate-200 bg-white shadow-sm hover:-translate-y-1 hover:shadow-md dark:border-navy-800 dark:bg-navy-900 dark:shadow-none dark:hover:border-navy-700"
          }`}
          style={`transition-delay: ${i * 80}ms`}
        >
          {plan.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-blue-600 px-4 py-1 text-xs font-bold text-white shadow-sm" data-i18n="price.popular">{t["price.popular"]}</span>
          )}

          <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white" data-i18n={`${plan.id}.name`}>{t[`${plan.id}.name`]}</h3>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-display text-4xl font-extrabold text-slate-900 dark:text-white" data-i18n={`${plan.id}.price`}>{t[`${plan.id}.price`]}</span>
            <span class="mb-1.5 text-sm text-slate-400" data-i18n={`${plan.id}.period`}>{t[`${plan.id}.period`]}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400" data-i18n={`${plan.id}.desc`}>{t[`${plan.id}.desc`]}</p>

          <a
            href="https://sems-application-web.vercel.app/login"
            data-i18n={`${plan.id}.cta`}
            class={`mt-6 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition-all ${
              plan.featured
                ? "bg-blue-600 text-white shadow-md shadow-blue-600/25 hover:bg-blue-700"
                : "border border-slate-300 text-slate-700 hover:border-blue-400 hover:text-blue-600 dark:border-navy-700 dark:text-slate-200 dark:hover:text-blue-400"
            }`}
          >
            {t[`${plan.id}.cta`]}
          </a>

          <ul class="mt-7 space-y-3.5 border-t border-slate-100 pt-7 dark:border-navy-800">
            {plan.features.map((f) => (
              <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" class="mt-0.5 shrink-0"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span data-i18n={f}>{t[f]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="reveal mt-8 text-center text-xs text-slate-400" data-i18n="price.note">{t["price.note"]}</p>
  </div>
</section>
